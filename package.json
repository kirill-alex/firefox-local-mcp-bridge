{
  "name": "firefox-local-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local Firefox WebExtension and WebDriver BiDi bridge for MCP clients",
  "type": "module",
  "license": "MIT",
  "engines": {"node": ">=24"},
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node bridge.mjs --broker",
    "test": "node --test tests/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "build": "node scripts/package-extension.mjs",
    "check": "npm test && npm run check:public && npm run build"
  },
  "devDependencies": {"jsdom": "31.0.0"}
}
